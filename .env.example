# Select "local" for persistent Chroma + deterministic demo embeddings, or "pinecone" for hosted retrieval.
VECTOR_STORE_BACKEND=local
CHROMA_PERSIST_DIRECTORY=./.chroma
CHROMA_COLLECTION=agentic-ai-ebook

# Required for Pinecone; OPENAI_API_KEY is also required for OpenAI generation.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=agentic-ai-ebook

# Required when VECTOR_STORE_BACKEND=pinecone. Local mode does not need this key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
PDF_PATH=./data/Ebook-Agentic-AI.pdf
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
MIN_RELEVANCE_SCORE=0.35
